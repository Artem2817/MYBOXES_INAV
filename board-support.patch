+static void dronecanGpsNoFix(void)
+{
+    gpsSolDRV.fixType = GPS_NO_FIX;
+    gpsSolDRV.flags.validVelNE = false;
+    gpsSolDRV.flags.validVelD = false;
+    gpsSolDRV.flags.validEPE = false;
+    gpsProcessNewDriverData();
+    newDataReady = true;
+}
+
+static bool dronecanGpsFixValid(uint8_t status, int64_t latitude, int64_t longitude,
+    int32_t altitudeMm, const float velocity[3])
+{
+    if (status > 3 || latitude < -9000000000LL || latitude > 9000000000LL ||
+        longitude < -18000000000LL || longitude > 18000000000LL ||
+        altitudeMm < -100000000 || altitudeMm > 100000000) {
+        return false;
+    }
+    // INAV stores cm/s in int16_t, including horizontal vector length.
+    for (unsigned axis = 0; axis < 3; axis++) {
+        if (!isfinite(velocity[axis]) || fabsf(velocity[axis]) > 300.0f) {
+            return false;
+        }
+    }
+    return velocity[0] * velocity[0] + velocity[1] * velocity[1] <= 90000.0f;
+}
+
+static uint16_t dronecanGpsDop(float dop)
+{
+    if (!isfinite(dop) || dop <= 0.0f) {
+        return 9999;
+    }
+    return gpsConstrainHDOP((uint32_t)fminf(dop * 100.0f, 9999.0f));
+}
+
+static void dronecanGpsSetCovariance(float varX, float varY, float varZ)
+{
+    gpsSolDRV.flags.validEPE = false;
+    if (!isfinite(varX) || !isfinite(varY) || !isfinite(varZ) ||
+        varX < 0 || varY < 0 || varZ < 0 || varX > 1.0e8f || varY > 1.0e8f || varZ > 1.0e8f) {
+        return;
+    }
+    gpsSolDRV.eph = gpsConstrainEPE((uint32_t)fminf(sqrtf(varX + varY) * 100.0f, 9999.0f));
+    gpsSolDRV.epv = gpsConstrainEPE((uint32_t)fminf(sqrtf(varZ) * 100.0f, 9999.0f));
+    gpsSolDRV.flags.validEPE = true;
+}
