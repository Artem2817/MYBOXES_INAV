index 0000000..52cca81
--- /dev/null
+++ b/src/main/drivers/compass/compass_dronecan.c
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <stdbool.h>
+#include <stdint.h>
+#include <math.h>
+#include "platform.h"
+#ifdef USE_MAG_DRONECAN
+#include "common/axis.h"
+#include "drivers/time.h"
+#include "drivers/compass/compass.h"
+#include "drivers/compass/compass_dronecan.h"
+
+static int16_t fieldMilliGauss[3];
+static uint32_t lastUpdateMs;
+static bool hasSample;
+static uint8_t selectedNode;
+static uint8_t selectedSensor;
+
+static bool dronecanMagInit(magDev_t *mag)
+{
+    (void)mag;
+    hasSample = false;
+    selectedNode = 0;
+    return true;
+}
+
+void dronecanMagReceive(uint8_t nodeId, uint8_t sensorId, const float fieldGauss[3])
+{
+    if (nodeId == 0 || nodeId > 127) {
+        return;
+    }
+    for (unsigned axis = 0; axis < 3; axis++) {
+        if (!isfinite(fieldGauss[axis]) || fabsf(fieldGauss[axis]) > 16.0f) {
+            return;
+        }
+    }
+    if (fieldGauss[0] == 0 && fieldGauss[1] == 0 && fieldGauss[2] == 0) {
+        return;
+    }
+    if (selectedNode && (nodeId != selectedNode || sensorId != selectedSensor)) {
+        return;
+    }
+    selectedNode = nodeId;
+    selectedSensor = sensorId;
+    for (unsigned axis = 0; axis < 3; axis++) {
+        fieldMilliGauss[axis] = (int16_t)lrintf(fieldGauss[axis] * 1000.0f);
+    }
+    lastUpdateMs = millis();
+    hasSample = true;
+}
+
+static bool dronecanMagRead(magDev_t *mag)
+{
+    if (!hasSample || (uint32_t)(millis() - lastUpdateMs) > 500U) {
+        return false;
+    }
+    for (unsigned axis = 0; axis < 3; axis++) {
+        mag->magADCRaw[axis] = fieldMilliGauss[axis];
+    }
+    return true;
+}
+
+bool dronecanMagDetect(magDev_t *mag)
+{
+    mag->init = dronecanMagInit;
+    mag->read = dronecanMagRead;
+    return true;
+}
+#endif
