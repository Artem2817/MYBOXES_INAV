diff --git a/src/main/drivers/accgyro/accgyro_icm42670.c b/src/main/drivers/accgyro/accgyro_icm42670.c
new file mode 100644
index 0000000..3842b46
--- /dev/null
+++ b/src/main/drivers/accgyro/accgyro_icm42670.c
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <stdint.h>
+
+#include "platform.h"
+
+#ifdef USE_IMU_ICM42670
+#include "drivers/accgyro/accgyro_icm42670.h"
+#include "drivers/time.h"
+
+// TDK DS-000451, user bank 0. UI sensor data is big-endian after reset.
+enum {
+    ICM42670_REG_RESET = 0x02,
+    ICM42670_REG_TEMP = 0x09,
+    ICM42670_REG_ACCEL = 0x0b,
+    ICM42670_REG_GYRO = 0x11,
+    ICM42670_REG_POWER = 0x1f,
+    ICM42670_REG_GYRO_CONFIG = 0x20,
+    ICM42670_REG_ACCEL_CONFIG = 0x21,
+    ICM42670_REG_DRDY = 0x39,
+    ICM42670_REG_WHO_AM_I = 0x75,
+    ICM42670_WHO_AM_I = 0x67,
+    ICM42670_SOFT_RESET = 0x10,
+    ICM42670_LOW_NOISE = 0x0f,
+    ICM42670_ODR_1600_HZ = 0x05,
+    ICM42670_DRDY = 0x01,
+};
+
+static int16_t icm42670ReadWord(const uint8_t *bytes)
+{
+    return (int16_t)((uint16_t)bytes[0] << 8 | bytes[1]);
+}
+
+static bool icm42670ReadAxes(busDevice_t *dev, uint8_t reg, float *axes)
+{
+    uint8_t bytes[6];
+    int16_t samples[XYZ_AXIS_COUNT];
+    if (!busReadBuf(dev, reg, bytes, sizeof(bytes))) {
+        return false;
+    }
+    for (unsigned axis = 0; axis < XYZ_AXIS_COUNT; ++axis) {
+        samples[axis] = icm42670ReadWord(&bytes[2 * axis]);
+        if (samples[axis] == INT16_MIN) {
+            return false;
+        }
+    }
+    for (unsigned axis = 0; axis < XYZ_AXIS_COUNT; ++axis) {
+        axes[axis] = samples[axis];
+    }
+    return true;
+}
+
+static bool icm42670GyroRead(gyroDev_t *gyro)
+{
+    uint8_t status;
+    return busRead(gyro->busDev, ICM42670_REG_DRDY, &status)
+        && status == ICM42670_DRDY
+        && icm42670ReadAxes(gyro->busDev, ICM42670_REG_GYRO, gyro->gyroADCRaw);
+}
+
+static bool icm42670AccRead(accDev_t *acc)
+{
+    return icm42670ReadAxes(acc->busDev, ICM42670_REG_ACCEL, acc->ADCRaw);
+}
+
+static bool icm42670ReadTemperature(gyroDev_t *gyro, int16_t *temperature)
+{
+    uint8_t bytes[2];
+    if (!busReadBuf(gyro->busDev, ICM42670_REG_TEMP, bytes, sizeof(bytes))) {
+        return false;
+    }
+    const int16_t raw = icm42670ReadWord(bytes);
+    if (raw == INT16_MIN) {
+        return false;
+    }
+    // INAV temperature callbacks use tenths of a degree Celsius.
+    *temperature = 250 + (int16_t)(raw / 12.8f);
+    return true;
+}
+
+static void icm42670AccInit(accDev_t *acc)
+{
+    acc->acc_1G = 2048; // +/-16 g, FS selector 0
+}
+
+static void icm42670GyroInit(gyroDev_t *gyro)
+{
+    gyro->sampleRateIntervalUs = 625; // 1600 Hz
+}
+
+static bool icm42670Configure(busDevice_t *dev)
+{
+    uint8_t id;
+    busSetSpeed(dev, BUS_SPEED_INITIALIZATION);
+    if (!busRead(dev, ICM42670_REG_WHO_AM_I, &id) || id != ICM42670_WHO_AM_I
+        || !busWrite(dev, ICM42670_REG_RESET, ICM42670_SOFT_RESET)) {
+        return false;
+    }
+    delay(10);
+    // FS selector 0 is +/-2000 dps and +/-16 g. Keep the reset filter settings.
+    if (!busWrite(dev, ICM42670_REG_GYRO_CONFIG, ICM42670_ODR_1600_HZ)
+        || !busWrite(dev, ICM42670_REG_ACCEL_CONFIG, ICM42670_ODR_1600_HZ)
+        || !busWrite(dev, ICM42670_REG_POWER, ICM42670_LOW_NOISE)) {
+        return false;
+    }
+    delay(50); // Gyro startup, including the register-write guard after power-up.
+    uint8_t gyroConfig, accelConfig, power;
+    return busRead(dev, ICM42670_REG_GYRO_CONFIG, &gyroConfig)
+        && gyroConfig == ICM42670_ODR_1600_HZ
+        && busRead(dev, ICM42670_REG_ACCEL_CONFIG, &accelConfig)
+        && accelConfig == ICM42670_ODR_1600_HZ
+        && busRead(dev, ICM42670_REG_POWER, &power)
+        && (power & ICM42670_LOW_NOISE) == ICM42670_LOW_NOISE;
+}
+
+bool icm42670GyroDetect(gyroDev_t *gyro)
+{
+    gyro->busDev = busDeviceInit(BUSTYPE_SPI, DEVHW_ICM42670, gyro->imuSensorToUse, OWNER_MPU);
+    if (!gyro->busDev) {
+        return false;
+    }
+    if (!icm42670Configure(gyro->busDev)) {
+        busDeviceDeInit(gyro->busDev);
+        gyro->busDev = NULL;
+        return false;
+    }
+    gyro->initFn = icm42670GyroInit;
+    gyro->readFn = icm42670GyroRead;
+    gyro->intStatusFn = gyroCheckDataReady;
+    gyro->temperatureFn = icm42670ReadTemperature;
+    gyro->scale = 1.0f / 16.4f;
+    gyro->gyroAlign = gyro->busDev->param;
+    return true;
+}
+
+bool icm42670AccDetect(accDev_t *acc)
+{
+    acc->busDev = busDeviceOpen(BUSTYPE_SPI, DEVHW_ICM42670, acc->imuSensorToUse);
+    if (!acc->busDev) {
+        return false;
+    }
+    acc->initFn = icm42670AccInit;
+    acc->readFn = icm42670AccRead;
+    acc->accAlign = acc->busDev->param;
+    return true;
+}
+#endif
